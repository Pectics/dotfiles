# For not only chezmoi
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
alias cm="chezmoi"

# Tailscale commands
{{- if eq .chezmoi.os "linux" }}
