# For not only chezmoi
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
alias cm="chezmoi"

# Tailscale commands
{{- if eq .chezmoi.os "linux" }}
  {{- if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
alias tailscale="tailscale.exe"
_TS_BIN="tailscale.exe"
  {{- else }}
_TS_BIN="tailscale"
  {{- end }}
{{- end }}

ts() {
    case "$1${2:+ $2}" in
        ping-all|pingall|"ping all")
            "$_TS_BIN" status --self=false | awk 'NF>=2 && $1 !~ /^#/ {print $2}' | xargs -I {} -P 0 sh -c '
                out=$($1 ping --timeout=60s "$2" 2>&1)
                printf "=== %s ===\n%s\n\n" "$2" "$out"
            ' _ "$_TS_BIN" {}
            ;;
        *)
            "$_TS_BIN" "$@"
            ;;
    esac
}

alias l="ls"
alias ll="ls -la"

